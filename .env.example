# ---- Телеграм-бот -----------------------------------------------------
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AA...
# Кому можно работать с ботом (через запятую). Свой ID: @userinfobot или /id боту.
# Без этого списка бот не запустится: он выдаёт пароли и умеет удалять сотрудников.
TELEGRAM_ALLOWED_USERS=123456789

# ---- Одна организация -------------------------------------------------
# Для нескольких организаций эти четыре строки не нужны — заполните
# config/orgs.json (образец: config/orgs.example.json).
# OAuth-токен с oauth.yandex.ru под администратором организации.
# Права: directory:read_users, directory:write_users, directory:read_departments
Y360_TOKEN=y0_AgAAAAA...
# ID организации — узнать: docker compose run --rm cli orgs
Y360_ORG_ID=1234567
Y360_ORG_NAME=Моя компания
Y360_DOMAIN=example.ru

# ---- Как заводить сотрудников -----------------------------------------
# Шаблон логина: {first} {last} {f} {l}
#   {first}.{last} -> ivan.ivanov     {f}{last} -> iivanov     {last} -> ivanov
Y360_NICKNAME_PATTERN={first}.{last}
Y360_PASSWORD_LENGTH=14
# Требовать смену пароля при первом входе
Y360_PASSWORD_CHANGE_REQUIRED=true
# Отдел по умолчанию, если он не указан в сообщении (имя или ID; пусто — «Все сотрудники»)
BOT_DEFAULT_DEPARTMENT=

# ---- Осторожные настройки ---------------------------------------------
# Кнопка «Удалить» в карточке сотрудника. Удаление необратимо: пропадают
# почта и Диск. Оставьте false, если хватает блокировки.
BOT_ALLOW_DELETE=false
# Удалять сообщение с паролем из чата через N секунд (0 — не удалять)
BOT_AUTO_DELETE_SECONDS=0
# Писать пароли в журнал data/journal.csv (по умолчанию нет)
BOT_LOG_PASSWORDS=false

# ---- Хранение ---------------------------------------------------------
DATA_DIR=data
# BOT_AUDIT_FILE=data/journal.csv
# BOT_INVOICES_DIR=data/invoices
# Y360_ORGS_FILE=config/orgs.json
